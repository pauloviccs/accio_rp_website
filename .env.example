# Supabase Credentials (Obtidas no painel do Supabase -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Webhooks Discord Opcionais (sobrescrevem website/src/config/webhooks.json quando definidos)
VITE_DISCORD_WEBHOOK_APPROVED=
VITE_DISCORD_WEBHOOK_REJECTED=
VITE_DISCORD_WEBHOOK_PENDING=


